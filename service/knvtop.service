[Unit]
Description=knvtop GPU+LLM monitor D-Bus service
After=graphical-session-pre.target
Wants=graphical-session-pre.target

[Service]
# Runs via a dedicated python3 interpreter copy carrying cap_sys_ptrace
# (see README.md "Cross-user GPU stats" section) so gpu_proc_sample()/
# llm_sample() can read /proc/<pid>/fdinfo for processes owned by a
# different user than this service (e.g. an isolated `aistack` account
# running llama.cpp) -- that file is otherwise kernel-restricted to
# same-uid-or-root. Falls back to plain python3 (no cross-user GPU%/VRAM,
# everything else still works) if that dedicated copy isn't set up yet.
ExecStart=/bin/sh -c 'exec "$([ -x /usr/local/lib/knvtop/python3-ptrace ] && echo /usr/local/lib/knvtop/python3-ptrace || echo python3)" %h/Code/knvtop/service/knvtop_service.py'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
